# ZeroMonitor Configuration - Copy to .env and fill in actual values
# DO NOT COMMIT .env TO REPOSITORY - IT CONTAINS SENSITIVE DATA

# Email/SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=alert-recipient@example.com

# Optional: Enable/disable email alerts
SEND_ALERTS=true

# Optional: Custom threshold overrides
# CPU_LOAD_THRESHOLD=0.80
# MEM_USED_THRESHOLD=85.0
# DISK_USED_THRESHOLD=90.0

